<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="boleto_cliente"
    pageWidth="595"
    pageHeight="842"
    columnWidth="535"
    leftMargin="30"
    rightMargin="30"
    topMargin="30"
    bottomMargin="30"
    whenNoDataType="AllSectionsNoDetail">

    <!-- ========================= -->
    <!-- PARÁMETROS DEL BOLETO -->
    <!-- ========================= -->

    <parameter name="codigoBoleto" class="java.lang.String"/>
    <parameter name="correo" class="java.lang.String"/>
    <parameter name="tipoBoleto" class="java.lang.String"/>
    <parameter name="estadoBoleto" class="java.lang.String"/>
    <parameter name="resultadoBoleto" class="java.lang.String"/>

    <parameter name="montoApostado" class="java.lang.String"/>
    <parameter name="comisionServicio" class="java.lang.String"/>
    <parameter name="totalCargo" class="java.lang.String"/>
    <parameter name="cuotaTotal" class="java.lang.String"/>
    <parameter name="premioPotencial" class="java.lang.String"/>

    <parameter name="fechaCreacion" class="java.lang.String"/>
    <parameter name="fechaLiquidacion" class="java.lang.String"/>
    <parameter name="referenciaOperacion" class="java.lang.String"/>

    <!-- ========================= -->
    <!-- CAMPOS DEL DETALLE -->
    <!-- ========================= -->

    <field name="evento" class="java.lang.String"/>
    <field name="mercado" class="java.lang.String"/>
    <field name="seleccion" class="java.lang.String"/>
    <field name="cuotaAplicada" class="java.math.BigDecimal"/>
    <field name="resultado" class="java.lang.String"/>

    <!-- ========================= -->
    <!-- TÍTULO -->
    <!-- ========================= -->

    <title>
        <band height="100">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="535"
                    height="30"/>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font
                        size="18"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[PLATAFORMA DE APUESTAS]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="0"
                    y="32"
                    width="535"
                    height="20"/>

                <textElement
                    textAlignment="Center">

                    <font
                        size="12"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[COMPROBANTE DE APUESTA]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="0"
                    y="62"
                    width="110"
                    height="20"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Código de boleto:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="110"
                    y="62"
                    width="250"
                    height="20"/>

                <textFieldExpression><![CDATA[
                    $P{codigoBoleto}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="365"
                    y="62"
                    width="60"
                    height="20"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Estado:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="425"
                    y="62"
                    width="110"
                    height="20"/>

                <textFieldExpression><![CDATA[
                    $P{estadoBoleto}
                ]]></textFieldExpression>
            </textField>

            <line>
                <reportElement
                    x="0"
                    y="92"
                    width="535"
                    height="1"/>
            </line>

        </band>
    </title>

    <!-- ========================= -->
    <!-- INFORMACIÓN GENERAL -->
    <!-- ========================= -->

    <pageHeader>
        <band height="125">

            <staticText>
                <reportElement
                    x="0"
                    y="5"
                    width="100"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Cliente:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="100"
                    y="5"
                    width="435"
                    height="18"/>

                <textFieldExpression><![CDATA[
                    $P{correo}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="0"
                    y="28"
                    width="100"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Tipo:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="100"
                    y="28"
                    width="160"
                    height="18"/>

                <textFieldExpression><![CDATA[
                    $P{tipoBoleto}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="270"
                    y="28"
                    width="80"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Resultado:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="350"
                    y="28"
                    width="185"
                    height="18"/>

                <textFieldExpression><![CDATA[
                    $P{resultadoBoleto}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="0"
                    y="51"
                    width="100"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Fecha compra:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="100"
                    y="51"
                    width="160"
                    height="18"/>

                <textFieldExpression><![CDATA[
                    $P{fechaCreacion}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="270"
                    y="51"
                    width="100"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Liquidación:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="370"
                    y="51"
                    width="165"
                    height="18"/>

                <textFieldExpression><![CDATA[
                    $P{fechaLiquidacion}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="0"
                    y="77"
                    width="100"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Referencia:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="100"
                    y="77"
                    width="435"
                    height="18"/>

                <textFieldExpression><![CDATA[
                    $P{referenciaOperacion}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="0"
                    y="104"
                    width="535"
                    height="18"/>

                <textElement>
                    <font
                        size="11"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Detalle de selecciones]]></text>
            </staticText>

        </band>
    </pageHeader>

    <!-- ========================= -->
    <!-- ENCABEZADO DE TABLA -->
    <!-- ========================= -->

    <columnHeader>
        <band height="28">

            <staticText>
                <reportElement
                    x="0"
                    y="0"
                    width="180"
                    height="28"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Evento]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="180"
                    y="0"
                    width="130"
                    height="28"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Mercado]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="310"
                    y="0"
                    width="125"
                    height="28"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Selección]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="435"
                    y="0"
                    width="50"
                    height="28"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Cuota]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="485"
                    y="0"
                    width="50"
                    height="28"/>

                <box>
                    <pen lineWidth="0.5"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle">

                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Res.]]></text>
            </staticText>

        </band>
    </columnHeader>

    <!-- ========================= -->
    <!-- DETALLE -->
    <!-- ========================= -->

    <detail>
        <band height="42">

            <textField isBlankWhenNull="true">
                <reportElement
                    x="0"
                    y="0"
                    width="180"
                    height="42"/>

                <box>
                    <pen lineWidth="0.25"/>
                </box>

                <textElement
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{evento}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    x="180"
                    y="0"
                    width="130"
                    height="42"/>

                <box>
                    <pen lineWidth="0.25"/>
                </box>

                <textElement
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{mercado}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    x="310"
                    y="0"
                    width="125"
                    height="42"/>

                <box>
                    <pen lineWidth="0.25"/>
                </box>

                <textElement
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{seleccion}
                ]]></textFieldExpression>
            </textField>

            <textField
                isBlankWhenNull="true"
                pattern="#,##0.00">

                <reportElement
                    x="435"
                    y="0"
                    width="50"
                    height="42"/>

                <box>
                    <pen lineWidth="0.25"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{cuotaAplicada}
                ]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement
                    x="485"
                    y="0"
                    width="50"
                    height="42"/>

                <box>
                    <pen lineWidth="0.25"/>
                </box>

                <textElement
                    textAlignment="Center"
                    verticalAlignment="Middle"/>

                <textFieldExpression><![CDATA[
                    $F{resultado}
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ========================= -->
    <!-- PIE -->
    <!-- ========================= -->

    <pageFooter>
        <band height="25">

            <line>
                <reportElement
                    x="0"
                    y="2"
                    width="535"
                    height="1"/>
            </line>

            <staticText>
                <reportElement
                    x="0"
                    y="7"
                    width="400"
                    height="15"/>

                <textElement>
                    <font size="8"/>
                </textElement>

                <text><![CDATA[Documento generado electrónicamente por PlataformaApuestas.]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="435"
                    y="7"
                    width="100"
                    height="15"/>

                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    "Página " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <!-- ========================= -->
    <!-- RESUMEN FINANCIERO -->
    <!-- ========================= -->

    <summary>
        <band height="160">

            <staticText>
                <reportElement
                    x="280"
                    y="15"
                    width="255"
                    height="22"/>

                <textElement
                    textAlignment="Center">

                    <font
                        size="11"
                        isBold="true"/>
                </textElement>

                <text><![CDATA[Resumen financiero]]></text>
            </staticText>

            <staticText>
                <reportElement
                    x="280"
                    y="45"
                    width="135"
                    height="18"/>

                <text><![CDATA[Monto apostado:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="415"
                    y="45"
                    width="120"
                    height="18"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression><![CDATA[
                    $P{montoApostado}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="280"
                    y="68"
                    width="135"
                    height="18"/>

                <text><![CDATA[Comisión servicio:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="415"
                    y="68"
                    width="120"
                    height="18"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression><![CDATA[
                    $P{comisionServicio}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="280"
                    y="91"
                    width="135"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Total pagado:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="415"
                    y="91"
                    width="120"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $P{totalCargo}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="280"
                    y="114"
                    width="135"
                    height="18"/>

                <text><![CDATA[Cuota total:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="415"
                    y="114"
                    width="120"
                    height="18"/>

                <textElement textAlignment="Right"/>

                <textFieldExpression><![CDATA[
                    $P{cuotaTotal}
                ]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement
                    x="280"
                    y="137"
                    width="135"
                    height="18"/>

                <textElement>
                    <font isBold="true"/>
                </textElement>

                <text><![CDATA[Premio potencial:]]></text>
            </staticText>

            <textField>
                <reportElement
                    x="415"
                    y="137"
                    width="120"
                    height="18"/>

                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>

                <textFieldExpression><![CDATA[
                    $P{premioPotencial}
                ]]></textFieldExpression>
            </textField>

        </band>
    </summary>

</jasperReport>
